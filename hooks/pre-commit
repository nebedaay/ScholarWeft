#!/bin/sh
# ScholarWeft pre-commit: keep the repo's markdown well-formed.
#
# Two rules, both mechanical:
#   1. no hard line wraps — one logical line per paragraph
#   2. a blank line between block elements (pandoc strict)
#
# Why mechanical: asking a person (or an agent) not to wrap does not reliably
# work — wrapping is a generation-time habit, not a decision.
#
# The checkers are vendored in this repo at tools/md/, so the hook works for
# anyone who clones it, with no external paths.
#
# Enable once per clone:   git config core.hooksPath hooks
# Bypass for one commit:   git commit --no-verify
#
# Template files are code, not prose (their lines are the template's output
# structure), so they are exempted below.

set -eu

repo_root=$(git rev-parse --show-toplevel)
unwrap="$repo_root/tools/md/unwrap-md.py"
blanks="$repo_root/tools/md/blankline-md.py"

if [ ! -f "$unwrap" ] || [ ! -f "$blanks" ]; then
    echo "pre-commit: tools/md/ checkers not found; skipping the markdown check." >&2
    exit 0
fi

# Only the markdown files in THIS commit, that still exist on disk.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' || true)
[ -z "$files" ] && exit 0

# Template sources and generated bundles are not prose.
prose=""
for f in $files; do
    case "$f" in
        *sw-literature-note-templates/*|*sw-zotlit-templates/*|*sw-markdown-templates/*) continue ;;
    esac
    [ -f "$f" ] && prose="$prose $f"
done
[ -z "$prose" ] && exit 0

if ! python3 "$unwrap" --check $prose; then
    cat >&2 <<'EOF'

pre-commit: the markdown above has hard line wraps (one logical line per
paragraph). Fix with:

    npm run fix-md

or commit with --no-verify to skip this check.
EOF
    exit 1
fi

if ! python3 "$blanks" --check $prose; then
    cat >&2 <<'EOF'

pre-commit: the markdown above is missing blank lines between block elements
(pandoc strict: heading↔text, paragraph↔list, …; items within a list stay
tight). Fix with:

    npm run fix-md

or commit with --no-verify to skip this check.
EOF
    exit 1
fi
